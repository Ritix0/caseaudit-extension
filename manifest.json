{
  "manifest_version": 3,
  "name": "Народный Аудитор Кейсов",
  "version": "1.0.0",
  "description": "Независимый краудсорсинговый математический мониторинг.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://audit.greenbatch.xyz/"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  }
}
